Host github.com
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

Host github-personal
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_personal
  IdentitiesOnly yes
  ControlMaster no
  ControlPath none

# Wildcard MUST stay last: ssh uses first-match-wins per option, so a leading
# `Host *` would override the per-host ControlMaster/ControlPath above (that bug
# made github-personal multiplex onto the work-authenticated github.com socket).
Host *
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h-%p
  ControlPersist 600
  ServerAliveInterval 60
